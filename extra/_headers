# Cloudflare Pages consumes this file (it is not served) to set response headers.
# The homepage embeds GNU Radio World, which needs SharedArrayBuffer and therefore a
# cross-origin isolated context. Scoped to the homepage only so the rest of the book
# keeps loading third-party subresources normally.
/
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/index.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
